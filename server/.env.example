# Shopify App Credentials (from Shopify Partner Dashboard)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app-tunnel.ngrok-free.app
SCOPES=read_products,write_products,read_orders,write_discounts,read_discounts

# Target Shopify Store
SHOP_DOMAIN=your-development-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server Configuration
PORT=3000
NODE_ENV=development
